{
  "name": "当選URL管理",
  "short_name": "URL送信",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "prefer_related_applications": false,
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "./icon-any-192.png?v=20260920-webapk-v2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-any.png?v=20260920-webapk-v2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.png?v=20260920-webapk-v2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backupFile",
          "accept": [
            "application/octet-stream",
            "application/zip",
            "application/x-zip-compressed",
            "application/zip-compressed",
            "application/x-novabackup",
            "application/x-nova-backup",
            "*/*"
          ]
        }
      ]
    }
  }
}
