{
  "name": "当選URL管理",
  "short_name": "URL送信",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "./icon-any-192.png?v=20260920-webapk-v1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-any.png?v=20260920-webapk-v1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.png?v=20260920-webapk-v1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "backupFile",
          "accept": [
            "*/*",
            ".novabackup",
            "application/zip",
            "application/octet-stream",
            "application/x-novabackup",
            "application/x-nova-backup"
          ]
        }
      ]
    }
  }
}
